<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <!-- viewport-fit=cover: rysowanie do krawędzi + env(safe-area-inset-*) w CSS -->
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <!-- pasek systemowy (Android) w kolorze motywu jasnego/ciemnego -->
  <meta name="theme-color" content="#eef2f7" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0b1220" media="(prefers-color-scheme: dark)">
  <title>Plan zajęć — wybór przedmiotów</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='style.css') }}?v={{ asset_v }}">
</head>
<body>
  <header class="topbar">
    <div class="topbar-title">
      <h1>Plan zajęć</h1>
      <span class="subtitle">kalendarz + wybór przedmiotów</span>
    </div>
    <div class="topbar-actions">
      <button class="btn" id="calendaryBtn" type="button" title="Kalendarium roku akademickiego 2026/2027">Kalendarium</button>
      <div class="week-switch" id="modeSwitch" role="group" aria-label="Tryb kalendarza"></div>
      <div class="week-switch" id="weekSwitch" role="group" aria-label="Wybór tygodnia"></div>
      <select class="theme-select" id="themeSelect" aria-label="Motyw kolorystyczny" title="Motyw kolorystyczny strony">
        <option value="auto">Motyw: auto</option>
        <option value="light">Jasny</option>
        <option value="dark">Ciemny</option>
        <option value="forest">Zieleń</option>
        <option value="violet">Fiolet</option>
        <option value="rose">Wrzos</option>
      </select>
      <details class="dropdown" id="downloadMenu">
        <summary class="btn" title="Eksport wybranego planu">Pobierz</summary>
        <div class="dropdown-menu" role="menu" aria-label="Format eksportu">
          <button type="button" role="menuitem" data-export="ics" title="Kalendarz do importu w Google Calendar / Outlook / telefonie">Kalendarz (.ics)</button>
          <button type="button" role="menuitem" data-export="pdf" title="Wektorowy PDF (zaznaczalny tekst) renderowany przez serwer; gdy serwer nie ma Chromium — wersja z przeglądarki">PDF (plik)</button>
          <button type="button" role="menuitem" data-export="print" title="Okno wydruku — cały kalendarz zmieści się na jednej stronie">Drukuj (1 strona)</button>
          <button type="button" role="menuitem" data-export="csv" title="Tabela planu do arkusza">CSV (tabela)</button>
          <button type="button" role="menuitem" data-export="json" title="Kopia wyboru do własnego backupu">JSON (kopia wyboru)</button>
          <button type="button" role="menuitem" data-export="png" title="Obraz aktualnego widoku kalendarza">PNG (obraz)</button>
        </div>
      </details>
      <button class="btn" id="shareBtn" type="button" title="Udostępnij plan linkiem /s/nazwa (na telefonie — systemowe udostępnianie)">Udostępnij</button>
      <button class="btn" id="saveSlugBtn" type="button" title="Zapisz plan na serwerze pod własnym adresem /s/nazwa — opcjonalnie z hasłem">Zapisz</button>
      <button class="btn" id="watchBtn" type="button" title="Obserwuj zmiany — mail po odświeżeniu danych kierunku (opt-out w każdej wiadomości)">Obserwuj</button>
      <button class="btn btn-ghost" id="resetBtn" type="button" title="Wyczyść wybór (poza obowiązkowymi)">Wyczyść</button>
    </div>
    <div class="status-chip" id="statusChip" aria-live="polite"></div>
  </header>

  <!-- v4: pasek statusu zapisu (/s/<slug>) — widoczny tylko w trybie sluga;
       wyraźnie pokazuje, czy slug jest publiczny, czy chroniony hasłem -->
  <div class="slugbar" id="slugBar" hidden>
    <span class="slug-status" id="slugStatus"></span>
    <div class="slugbar-actions" id="slugActions"></div>
  </div>

  <!-- krok 9: wybór kierunku (wydział → kierunek → semestr) + odświeżanie danych -->
  <div class="coursebar" id="courseBar" hidden>
    <label class="cbar-field">
      <span class="cbar-label">Wydział</span>
      <select class="cbar-select" id="facultySelect" aria-label="Wydział"></select>
    </label>
    <label class="cbar-field">
      <span class="cbar-label">Kierunek</span>
      <select class="cbar-select" id="courseSelect" aria-label="Kierunek"></select>
    </label>
    <label class="cbar-field">
      <span class="cbar-label">Semestr</span>
      <select class="cbar-select" id="etapSelect" aria-label="Semestr"></select>
    </label>
    <button class="btn" id="refreshBtn" type="button" title="Pobiera z e-KUL aktualny plan i rozkład tego kierunku (wszystkie jego semestry). Limity: do 100 żądań na dobę, do 5 odświeżeń tego samego kierunku, nie częściej niż co 15 min.">Odśwież</button>
    <span class="refresh-info" id="refreshInfo" aria-live="polite"></span>
  </div>

  <div id="statusPanel" class="status-panel" hidden></div>

  <!-- nagłówek tylko przy wydruku (PDF) -->
  <div id="printHead"></div>

  <main class="layout">
    <section class="calendar card" aria-label="Kalendarz tygodniowy">
      <div class="cal-scroll">
        <div class="cal-inner" id="calInner">
          <div class="cal-head" id="calHead"></div>
          <div class="cal-body" id="calBody"></div>
        </div>
      </div>
    </section>

    <aside class="picker card" id="picker" aria-label="Wybór przedmiotów"></aside>
  </main>

  <div id="toast" class="toast" role="alert" hidden></div>

  <!-- v4: zapis planu na serwerze (slug + opcjonalne hasło) -->
  <div class="modal-overlay" id="slugModal" hidden>
    <div class="modal-card modal-card-narrow" role="dialog" aria-modal="true" aria-labelledby="slugModalTitle">
      <div class="modal-head">
        <h2 id="slugModalTitle">Zapisz plan na serwerze</h2>
        <button class="modal-close" id="slugModalClose" type="button" aria-label="Zamknij" title="Zamknij">×</button>
      </div>
      <div class="modal-body">
        <p id="slugModalLead">Plan zostanie zapisany pod adresem <code>/s/nazwa</code> — każdy
          z linkem go zobaczy. Bez hasła może go też edytować każdy; z hasłem tylko
          osoby, które je znają.</p>
        <label class="modal-field" id="slugSlugField">
          <span>Adres (slug)</span>
          <input id="slugInput" type="text" autocomplete="off" autocapitalize="none"
                 spellcheck="false" maxlength="64" placeholder="np. moj-plan-2027">
        </label>
        <label class="modal-field" id="slugPasswordField">
          <span id="slugPasswordLabel">Hasło (opcjonalne)</span>
          <input id="slugPasswordInput" type="password" autocomplete="new-password"
                 maxlength="256" placeholder="puste = slug publiczny">
        </label>
        <label class="modal-field" id="slugNewPasswordField" hidden>
          <span>Nowe hasło (puste = usuń hasło)</span>
          <input id="slugNewPasswordInput" type="password" autocomplete="new-password"
                 maxlength="256" placeholder="puste = slug wraca do publicznego">
        </label>
        <p class="modal-error" id="slugModalError" hidden></p>
        <div class="modal-actions">
          <button class="btn" id="slugModalSave" type="button">Zapisz</button>
        </div>
      </div>
    </div>
  </div>

  <!-- v4 Faza 4: subskrypcja newslettera (opt-in podwójny) -->
  <div class="modal-overlay" id="watchModal" hidden>
    <div class="modal-card modal-card-narrow" role="dialog" aria-modal="true" aria-labelledby="watchModalTitle">
      <div class="modal-head">
        <h2 id="watchModalTitle">Obserwuj zmiany</h2>
        <button class="modal-close" id="watchModalClose" type="button" aria-label="Zamknij" title="Zamknij">×</button>
      </div>
      <div class="modal-body">
        <p id="watchModalLead"></p>
        <label class="modal-field">
          <span>Adres e-mail</span>
          <input id="watchEmailInput" type="email" autocomplete="email" maxlength="254" placeholder="ty@example.com">
        </label>
        <p class="modal-error" id="watchModalError" hidden></p>
        <div class="modal-actions">
          <button class="btn" id="watchModalSave" type="button">Obserwuj</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="calendaryModal" hidden>
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="calendaryTitle">
      <div class="modal-head">
        <h2 id="calendaryTitle">Kalendarium roku akademickiego 2026/2027</h2>
        <button class="modal-close" id="calendaryClose" type="button" aria-label="Zamknij kalendarium" title="Zamknij">×</button>
      </div>
      <div class="modal-body" id="calendaryBody"></div>
    </div>
  </div>

  <footer class="site-footer">
    <a href="https://git.qbsoon.pl/Qbsoon/lecture-chooser" target="_blank" rel="noopener">Gitea</a>
    <a href="https://github.com/Qbsoon/lecture-chooser" target="_blank" rel="noopener">GitHub</a>
    <span>Tworzenie wspomagał model GLM</span>
    <span>Hostowane bez współpracy z KUL przez studenta na prywatnym serwerze. Kontakt: contact@qbsoon.pl</span>
  </footer>

  <script src="{{ url_for('static', filename='app.js') }}?v={{ asset_v }}"></script>
</body>
</html>
